# Copy this file to .env.local and fill in the values you have.
# Everything is optional: with nothing set, CharityContent runs in demo mode
# (accounts and content saved in the browser, built-in content writer).

# --- AI content generation (OpenAI) ---------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# --- Supabase (real accounts + database) ------------------------------------
# Project settings > API in your Supabase dashboard. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for the Stripe webhook to update plans. Never expose this.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (subscriptions) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the monthly plans you create in Stripe (£19 and £39).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Public URL of the app, used for Stripe redirects (e.g. https://app.charitycontent.co.uk)
NEXT_PUBLIC_APP_URL=http://localhost:3000
